# Kanalib 入库服务主配置。
# 复制到 /etc/kanalib/ingest.toml（0644）；令牌与密钥只写路径，文件权限 0600。
# 改这个文件需要重启服务；规则文件（rules.toml）才走热重载。

[service]
# 只绑 EasyTier 虚拟 IP；原图端点也复用这个地址，除非 [media].bind 覆盖。
bind = "10.126.126.3:8790"
db = "/var/lib/kanalib-ingest/ingest.db"
media_dir = "/var/lib/kanalib-ingest/media"
public_base = "http://kanalib-box.et.net:8790"
rules_file = "/etc/kanalib/rules.toml"
sync_interval_secs = 60

[source.pixiv]
enabled = true
bookmark_users = ["123456"]

# 二选一：
# 1) 已有 access token（手动换取后写文件，过期需人工更新）
# access_token_file = "/etc/kanalib/pixiv-access-token"
# 2) OAuth refresh token（推荐；access token 过期前自动刷新，轮换后的 refresh token 原子写回）
refresh_token_file = "/etc/kanalib/pixiv-refresh-token"
client_id = "pixiv-oauth-client-id"
client_secret = "pixiv-oauth-client-secret"
# credential_ref（keyring）尚未实现，填了会在启动时显式报错。
# credential_ref = "keyring:kanalib-pixiv"
user_agent = "Kanalib/0.1 (Pixiv ingest)"

# 无登录公开来源：与 source.pixiv 二选一，只抓匿名可见的全年龄作品。
# 没有收藏、私密内容和 R-18；每个目标按顺序抓取，pages 上限 10。
[source.public]
enabled = false
# user_agent = "Mozilla/5.0 ... Chrome/131.0 Safari/537.36"

[[source.public.targets]]
kind = "ranking"
mode = "daily"      # daily / weekly / monthly / rookie / original / male / female
content = "illust"  # illust / manga
pages = 1
limit = 50          # 每页最多取多少条；上限 100

# [[source.public.targets]]
# kind = "tag"
# tag = "花"
# order = "date_d"
# pages = 1
# limit = 50

# [[source.public.targets]]
# kind = "author"
# user_id = "59688623"
# pages = 1
# limit = 48

[download]
concurrency = 3
retry_max = 5
timeout_secs = 60
# 每轮最多下载多少条，然后让决策/推送跑一轮；0 = 不限制（积压时会饿死后续阶段）。
batch_items = 60

[tagging]
# 2026-11-27：GPU 打标机已回收，默认不配置 backend/endpoint。
# 未配置时，需要补标的条目直接转 review，不影响同轮其它 allow 条目推送。
# 标签不足 min_tags 时调用一次；endpoint 指向 box 上的 sidecar。
# backend = "http"
# endpoint = "http://127.0.0.1:8793/tag"
# 打标服务的共享 token；与 tagger 的 --token-file 内容一致。
# token_file = "/etc/kanalib/tagger-token"
concurrency = 2
timeout_secs = 1800

[push]
web_base = "http://kanalib-web.et.net:8788"
secret_file = "/etc/kanalib/ingest-hmac"
batch_size = 100
max_attempts = 5
backoff_base_secs = 5
backoff_max_secs = 600
# 默认使用当前生效的 rules.version；只有回放历史批次才需要覆盖。
# rules_version = "2026-11-22.1"

[admin]
# 管理页 / 审核 / 规则草稿 / 指标；只绑回环或 EasyTier 虚拟 IP，绝不绑 0.0.0.0。
enabled = true
bind = "10.126.126.3:8792"
# 非回环绑定必须配置 token，否则拒绝启动。
token_file = "/etc/kanalib/admin-token"
# 可选来源白名单；留空只靠 token。填了就只接受这些地址。
# allowed_ips = ["10.126.126.2"]

[media]
# 与 kanalib-web 的 --media-signing-key / KANALIB_MEDIA_SIGNING_KEY 相同。
signing_key_file = "/etc/kanalib/media-signing-key"
# 默认用 [service].bind；只有需要把原图端点放到别的地址时才覆盖。
# bind = "10.126.126.3:8790"
