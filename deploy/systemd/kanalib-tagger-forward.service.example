[Unit]
Description=Kanalib tagger TCP forward (EasyTier to local reverse tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Environment=KANALIB_TAGGER_FORWARD_BIND=10.126.126.2
Environment=KANALIB_TAGGER_FORWARD_PORT=8793
Environment=KANALIB_TAGGER_TARGET_HOST=127.0.0.1
Environment=KANALIB_TAGGER_TARGET_PORT=8793
ExecStart=/usr/bin/python3 /usr/local/bin/kanalib-tagger-forward.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
