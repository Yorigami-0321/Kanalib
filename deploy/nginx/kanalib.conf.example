server {
    listen 443 ssl;
    http2 on;
    server_name kanalib.example.com;

    ssl_certificate /etc/nginx/ssl/kanalib.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/kanalib.example.com/privkey.pem;

    client_max_body_size 0;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'" always;

    location ~ ^/api/items/[^/]+/original$ {
        return 404;
    }

    # 302 之后的相对回源路径只存在于私网 listener；公网直接拒绝。
    location ^~ /original/ {
        return 404;
    }

    location ^~ /internal/ {
        return 404;
    }

    location ^~ /api/desktop/ {
        return 404;
    }

    # 不能用 ^~：否则会跳过上面的原图正则，公开原图 404 失效。
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /media/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
    }

    location / {
        root /var/lib/kanalib-web/dist;
        try_files $uri /index.html;
    }
}
